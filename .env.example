# Postgres
DATABASE_URL=postgresql://prospeccao:prospeccao@localhost:5432/prospeccao_ia

# Retell AI (retellai.com -> Dashboard -> API Keys)
RETELL_API_KEY=
RETELL_AGENT_ID=

# ElevenLabs (você já tem esse clone pronto)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Segredo usado para validar que os webhooks vêm mesmo do Retell
RETELL_WEBHOOK_SECRET=

# Número WhatsApp (com DDI+DDD, ex: +5561999999999) que recebe aviso de lead novo.
# Sem essa variável, a notificação fica desligada.
NOTIFICAR_WHATSAPP=
