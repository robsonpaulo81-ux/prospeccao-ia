// app/api/indicacao/route.js
//
// Recebe o formulário público de indicação e grava:
// 1. o indicador (cria se não existir, reaproveita se já existir pelo telefone)
// 2. o lead indicado, já ligado ao indicador, na fase inicial do Kanban
//
// Ajuste o import abaixo para o mesmo helper de conexão que o resto do
// projeto já usa (ex: '@/lib/db' ou '@/lib/neon').
import { sql } from '@/lib/db';

export async function POST(request) {
  try {
    const body = await request.json();
    const {
      indicadorNome,
      indicadorTelefone,
      leadNome,
      leadTelefone,
      interesse, // 'casa' | 'apartamento' | 'nao_sabe'
    } = body;

    // Validação simples
    if (!indicadorNome || !leadNome || !leadTelefone) {
      return Response.json(
        { error: 'Nome do indicador, nome e telefone do indicado são obrigatórios.' },
        { status: 400 }
      );
    }

    // 1. Busca indicador existente pelo telefone (se informado) ou pelo nome
    let indicador;
    if (indicadorTelefone) {
      const existentes = await sql`
        SELECT * FROM indicadores WHERE telefone = ${indicadorTelefone} LIMIT 1
      `;
      indicador = existentes[0];
    }

    // 2. Se não existe, cria um novo indicador com código único
    if (!indicador) {
      const codigo = `${indicadorNome.toLowerCase().replace(/\s+/g, '-')}-${Date.now().toString().slice(-4)}`;
      const novos = await sql`
        INSERT INTO indicadores (nome, telefone, codigo_indicacao)
        VALUES (${indicadorNome}, ${indicadorTelefone || null}, ${codigo})
        RETURNING *
      `;
      indicador = novos[0];
    }

    // 3. Cria o lead já ligado ao indicador, na fase inicial do Kanban
    const leadInserido = await sql`
      INSERT INTO leads (nome, telefone, tipo_imovel, fase, indicado_por)
      VALUES (
        ${leadNome},
        ${leadTelefone},
        ${interesse || null},
        'atendido_qualificacao',
        ${indicador.id}
      )
      RETURNING *
    `;

    return Response.json({
      ok: true,
      lead: leadInserido[0],
      indicador,
    });
  } catch (err) {
    console.error('Erro ao processar indicação:', err);
    return Response.json(
      { error: 'Não foi possível registrar a indicação. Tente novamente.' },
      { status: 500 }
    );
  }
}
