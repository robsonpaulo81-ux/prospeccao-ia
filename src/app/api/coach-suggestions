
-- Migration: tabela para armazenar as sugestões do live coach por chamada.
-- Rodar contra o mesmo Postgres (Neon) já usado pelo app-prospeccao-ia.

CREATE TABLE IF NOT EXISTS coach_suggestions (
  id            BIGSERIAL PRIMARY KEY,
  call_id       TEXT NOT NULL,
  suggestion_type TEXT NOT NULL,       -- objecao | pergunta_qualificacao | sinal_de_compra |
                                        -- alerta | proxima_pergunta | pergunta_nao_respondida |
                                        -- clareza_comunicacao
  priority      TEXT NOT NULL,         -- alta | media | baixa
  text          TEXT NOT NULL,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- Índice para o painel buscar rápido "última sugestão desta chamada"
CREATE INDEX IF NOT EXISTS idx_coach_suggestions_call_id_created_at
  ON coach_suggestions (call_id, created_at DESC);
